# Copy to .env.prod on the server (git-ignored; not .env.production, which Next itself would
# load into any local `pnpm build`). It is read twice: by Compose for
# the ${…} values in docker-compose.prod.yml, and by the containers as their environment.
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ── Host ───────────────────────────────────────────────────────────────────
SITE_DOMAIN=jilaltufan.org
ACME_EMAIL=admin@jilaltufan.org
NEXT_PUBLIC_SITE_URL=https://jilaltufan.org
# Postgres password for the `jaa` user inside the compose network (the app's DATABASE_URL
# is derived from it). Any long random string.
POSTGRES_PASSWORD=
# ≥ 32 random characters. Rotating it logs every editor out.
PAYLOAD_SECRET=

# ── Image build only ───────────────────────────────────────────────────────
# Not read from this file: the build secret comes from the shell, so prefix the build
# command with it (DEPLOY.md step 4). A migrated database the build can reach with host
# networking — on the server, Postgres published on 127.0.0.1:5432 for the duration of the
# build; on the laptop, the dev database: postgresql://jaa:jaa@host.docker.internal:5432/jaa
#   BUILD_DATABASE_URL=postgresql://jaa:<POSTGRES_PASSWORD>@127.0.0.1:5432/jaa dc build app

# ── Media on Cloudflare R2 (recommended; without it uploads live in the `media` volume) ──
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (Zoho SMTP, same values as the preview) ──────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@jilaltufan.org
EMAIL_FROM_NAME="أكاديمية جيل الطوفان"
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Backups ────────────────────────────────────────────────────────────────
# A *private* bucket (never the public media bucket). Endpoint and keys default to S3_*.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=3

# ── Optional ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leave unset in production. Set to 1 only on a staging domain that must not be indexed.
SITE_NOINDEX=
