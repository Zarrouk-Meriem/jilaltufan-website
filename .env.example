# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jaa:jaa@127.0.0.1:5432/jaa
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (dev: leave empty → emails are logged to the console) ─────────────
# One of: resend | smtp | (empty)
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=no-reply@jilaltufan.org
EMAIL_FROM_NAME="أكاديمية جيل الطوفان"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Media storage (dev: leave empty → local filesystem in ./media) ──────────
# Set all four to enable the S3-compatible adapter (R2, S3, MinIO…).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Cloudflare Turnstile — inert when empty
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Show /styleguide in production builds
ENABLE_STYLEGUIDE=
# Standalone output for the Dockerfile
DOCKER_BUILD=
